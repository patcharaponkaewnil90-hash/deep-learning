   "source": [
    "## 19. แสดงภาพถูก 5 ภาพและผิด 5 ภาพ\n",
    "เลือก DNN หรือ CNN ที่ Test Accuracy สูงกว่าเพื่อแสดงตัวอย่างตามขั้นตอนงานเดิม การเลือกส่วนนี้ไม่เปลี่ยนโมเดลสุดท้ายที่เลือกด้วย Validation\n",
    "\n",
    "`np.where()` หาตำแหน่งที่ทำนายตรง/ไม่ตรงกับคำตอบจริง แล้ว `[:5]` เลือกห้าภาพแรก ตัวอย่างเหล่านี้ไม่ได้แทนความผิดพลาดทั้งหมด\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "10ea969b"
   },
   "id": "10ea969b",
   "source": [
    "example_name = max(\n",
    "    [\"DNN Original\", \"CNN Original\"],\n",
    "    key=lambda name: results[name][\"test_acc\"]\n",
    ")\n",
    "\n",
    "y_pred = predictions[example_name]\n",
    "\n",
    "correct_indices = np.where(y_pred == y_test)[0][:5]\n",
    "wrong_indices = np.where(y_pred != y_test)[0][:5]\n",
    "\n",
    "fig, axes = plt.subplots(2, 5, figsize=(14, 6))\n",
    "\n",
    "for row, indices in enumerate(\n",
    "    [correct_indices, wrong_indices]\n",
    "):\n",
    "    for col in range(5):\n",
    "        ax = axes[row, col]\n",
    "        ax.axis(\"off\")\n",
    "\n",
    "        if col >= len(indices):\n",
    "            continue\n",
    "        idx = indices[col]\n",
    "\n",
    "        ax.imshow(x_test[idx], cmap=\"gray\")\n",
    "        ax.set_title(\n",
    "            f\"True: {class_names[y_test[idx]]}\\n\"\n",
    "            f\"Pred: {class_names[y_pred[idx]]}\",\n",
    "            color=\"green\" if row == 0 else \"red\",\n",
    "            fontsize=9\n",
    "        )\n",
    "plt.suptitle(example_name)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ],
