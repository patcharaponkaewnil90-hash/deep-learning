   "id": "48252134",
   "source": [
    "## 17. ประเมิน Test ในรอบสุดท้าย\n",
    "เมื่อเลือกโมเดลแล้ว จึงประเมินทุกโมเดลที่ต้องรายงาน ห้ามใช้คะแนนนี้กลับไปปรับโมเดล โมเดลเดิมที่เลือก คือ DNN หรือ CNN ตัวเดิมจึงไม่ต้องประเมินซ้ำในชื่อใหม่ ตารางใช้ Accuracy เป็นสัดส่วน และแสดงผลโมเดลสุดท้ายเป็นเปอร์เซ็นต์เพิ่มเติม\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "e0df44c0"
   },
   "id": "e0df44c0",
   "source": [
    "for name, (model, xtr, xv, xt) in candidates.items():\n",
    "    test_loss, test_acc = model.evaluate(\n",
    "        xt, y_test, verbose=0\n",
    "    )\n",
    "\n",
    "    results[name][\"test_loss\"] = test_loss\n",
    "    results[name][\"test_acc\"] = test_acc\n",
    "\n",
    "    print(\n",
    "        f\"{name}: \"\n",
    "        f\"Train Acc={results[name]['train_acc']:.4f}, \"\n",
    "        f\"Val Acc={results[name]['val_acc']:.4f}, \"\n",
    "        f\"Test Acc={test_acc:.4f}, \"\n",
    "        f\"Test Loss={test_loss:.4f}\"\n",
    "    )\n",
    "results_table = pd.DataFrame(results).T\n",
    "results_table.index.name = \"Model\"\n",
    "display(results_table[[\"train_acc\", \"val_acc\", \"test_acc\", \"train_loss\", \"val_loss\", \"test_loss\"]].round(4))\n",
    "print(f\"Final selected model: {best_name}; test accuracy = {results[best_name]['test_acc']:.2%}\")\n",
    "print(\"โมเดลเดิมที่เลือก เทียบกับ โมเดลใหม่:\")\n",
    "display(results_table.loc[[selected_original_name, new_model_name]].round(4))\n"
   ],
   "execution_count": null,
   "outputs": []
