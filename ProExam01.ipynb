  {
   "cell_type": "markdown",
   "metadata": {
    "id": "be20e3e9"
   },
   "id": "be20e3e9",
   "source": [
    "## 15. เปรียบเทียบกราฟ โมเดลเดิมที่เลือก กับ โมเดลใหม่ (เพิ่ม Dropout + Early Stopping)\n",
    "ดู Validation Loss และ Accuracy ร่วมกัน อย่าตัดสินจากช่องว่างเล็กลงอย่างเดียว เพราะทั้งสองชุดอาจแย่ลงได้ Dropout ทำงานเฉพาะตอนฝึก จึงอาจเห็น Training Accuracy ต่ำกว่า Validation ได้\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 407
    },
    "id": "02d25f72",
    "outputId": "98425d94-a88b-406c-a0e3-e88989ec1f6e"
   },
   "id": "02d25f72",
   "source": [
    "if baseline is cnn_original:\n",
    "    baseline_history = history_cnn_original\n",
    "else:\n",
    "    baseline_history = history_dnn_original\n",
    "\n",
    "# กราฟ Loss ของโมเดลเดิมที่เลือกและโมเดลใหม่\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "for ax, name, history in zip(axes, [\"Baseline\", \"New\"], [baseline_history, history_new_model]):\n",
    "    epochs = range(1, len(history.history[\"loss\"]) + 1)\n",
    "    ax.plot(epochs, history.history[\"loss\"], label=\"Training Loss\")\n",
    "    ax.plot(epochs, history.history[\"val_loss\"], label=\"Validation Loss\")\n",
    "    ax.set(title=name, xlabel=\"Epoch\", ylabel=\"Loss\")\n",
    "    ax.legend()\n",
    "    ax.grid(alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "1700549c"
   },
   "id": "1700549c",
   "source": [
    "## 16. ประเมินน้ำหนักปัจจุบัน และเลือกโมเดลสุดท้ายก่อน Test\n",
    "`evaluate()` วัดผลโดยไม่ปรับน้ำหนัก ประเมินใหม่เพื่อให้คะแนนตรงกับน้ำหนักที่คืนมาจาก Early Stopping ผล Training ในตารางเป็นโหมดประเมิน (ไม่เปิด Dropout) จึงอาจต่างจาก History\n",
    "\n",
    "เลือกคะแนน Validation สูงสุดจากทั้งสามตัว ถ้าเท่ากัน เลือก โมเดลเดิมที่เลือก ก่อน แล้วจึงตัวอื่นตามลำดับที่กำหนด\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 211
    },
    "id": "c4285724",
    "outputId": "f57bee8f-780b-431a-ab91-8c66c6ec8cf7"
   },
   "id": "c4285724",
   "source": [
    "if baseline is cnn_original:\n",
    "    selected_original_name = \"CNN Original\"\n",
    "    new_model_name = \"CNN New (Dropout + L2 + Early Stopping)\"\n",
    "else:\n",
    "    selected_original_name = \"DNN Original\"\n",
    "    new_model_name = \"DNN New (Dropout + L2 + Early Stopping)\"\n",
    "\n",
    "candidates = {\n",
    "    \"DNN Original\": (dnn_original, x_train, x_val, x_test),\n",
    "    \"CNN Original\": (cnn_original, x_train_cnn, x_val_cnn, x_test_cnn),\n",
    "    new_model_name: (\n",
    "        new_model,\n",
    "        x_train_selected,\n",
    "        x_val_selected,\n",
    "        x_test_selected\n",
    "    )\n",
    "}\n",
    "\n",
    "results = {}\n",
    "\n",
    "for name, (model, xtr, xv, xt) in candidates.items():\n",
    "    train_loss, train_acc = model.evaluate(\n",
    "        xtr, y_train, verbose=0\n",
    "    )\n",
    "    val_loss, val_acc = model.evaluate(\n",
    "        xv, y_val, verbose=0\n",
    "    )\n",
    "\n",
    "    results[name] = {\n",
    "        \"train_loss\": train_loss,\n",
    "        \"train_acc\": train_acc,\n",
    "        \"val_loss\": val_loss,\n",
    "        \"val_acc\": val_acc\n",
    "    }\n",
    "\n",
    "selection_order = [selected_original_name, \"DNN Original\" if baseline is cnn_original else \"CNN Original\", new_model_name]\n",
    "best_name = max(\n",
    "    selection_order,\n",
    "    key=lambda name: results[name][\"val_acc\"]\n",
    ")\n",
    "\n",
    "print(\"Final model selected by validation:\", best_name)\n",
    "validation_table = pd.DataFrame(results).T\n",
    "validation_table.index.name = \"Model\"\n",
    "display(validation_table.round(4))\n",
    "original_result = results[selected_original_name]\n",
    "new_result = results[new_model_name]\n",
    "print(f\"New model minus original model validation accuracy: {(new_result['val_acc']-original_result['val_acc'])*100:+.3f} percentage points\")\n",
    "print(f\"New model minus original model validation loss: {new_result['val_loss']-original_result['val_loss']:+.4f}\")\n",
    "print(\"Positive accuracy difference is better; negative loss difference is better.\")\n",
    "final_model = candidates[best_name][0]\n"
