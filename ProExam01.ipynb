   "id": "e1a82118",
   "source": [
    "dnn_original = models.Sequential([\n",
    "    layers.Input(shape=(28, 28)),\n",
    "    layers.Flatten(),\n",
    "    layers.Dense(128, activation=\"relu\"),\n",
    "    layers.Dense(64, activation=\"relu\"),\n",
    "    layers.Dense(10, activation=\"softmax\")\n",
    "], name=\"dnn_original\")\n",
    "\n",
    "dnn_original.summary()\n"
