    "id": "8e62f922"
   },
   "id": "8e62f922",
   "source": [
    "## 14. ฝึก โมเดลใหม่ (เพิ่ม Dropout + Early Stopping) ด้วยข้อมูลเดิม\n",
    "ติดตาม val_accuracy แบบค่าสูงดีกว่า ถ้าไม่ดีขึ้น 3 Epoch ติดต่อกันให้หยุด และคืนค่าน้ำหนักที่ดีที่สุด เพดานยังเป็น 10 Epoch เหมือนเดิม อาจฝึกครบโดยไม่หยุดก่อนก็ได้ ตาราง History ยังคงมี Epoch หลังจุดที่ดีที่สุดแม้คืนน้ำหนักแล้ว\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "faa390de",
    "outputId": "c3c59a68-a881-494f-93cc-cbeb3cbbc178"
   },
   "id": "faa390de",
   "source": [
    "early_stop = tf.keras.callbacks.EarlyStopping(\n",
    "    monitor=\"val_accuracy\",\n",
    "    mode=\"max\",\n",
    "    patience=3,\n",
    "    restore_best_weights=True\n",
    ")\n",
    "\n",
    "history_new_model = new_model.fit(\n",
    "    x_train_selected,\n",
    "    y_train,\n",
    "    validation_data=(x_val_selected, y_val),\n",
    "    epochs=EPOCHS,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    callbacks=[early_stop]\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Actual epochs:\",\n",
    "    len(history_new_model.history[\"loss\"])\n",
    ")\n"
   ],
