   "id": "07642576",
   "source": [
    "## 18. ดูว่า DNN และ CNN สับสนคลาสไหน\n",
    "`predict()` ให้คะแนน 10 คลาสต่อภาพ `argmax(axis=1)` เลือกเลขคลาสที่คะแนนสูงที่สุดในแต่ละแถว\n",
    "\n",
    "Confusion Matrix: แถว = คำตอบจริง คอลัมน์ = คำทำนาย แนวทแยง = ถูก นอกแนวทแยง = ผิด เช่น แถว Shirt คอลัมน์ T-shirt/top หมายถึง Shirt ถูกทำนายเป็น T-shirt/top\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {
    "id": "5dc194b6"
   },
   "id": "5dc194b6",
   "source": [
    "predictions = {}\n",
    "probabilities_by_model = {}\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
    "\n",
    "for ax, name in zip(axes, [\"DNN Original\", \"CNN Original\"]):\n",
    "    model, _, _, xt = candidates[name]\n",
    "\n",
    "    probabilities = model.predict(xt, verbose=0)\n",
    "    y_pred = np.argmax(probabilities, axis=1)\n",
    "\n",
    "    predictions[name] = y_pred\n",
    "    probabilities_by_model[name] = probabilities\n",
    "    print(f\"{name}: probabilities shape={probabilities.shape}, predictions shape={y_pred.shape}\")\n",
    "    print(f\"Correct={np.sum(y_pred == y_test)}, Incorrect={np.sum(y_pred != y_test)}\")\n",
    "\n",
    "    ConfusionMatrixDisplay.from_predictions(\n",
    "        y_test,\n",
    "        y_pred,\n",
    "        labels=np.arange(10),\n",
    "        display_labels=class_names,\n",
    "        cmap=\"Blues\",\n",
    "        xticks_rotation=90,\n",
    "        colorbar=False,\n",
    "        ax=ax\n",
    "    )\n",
    "\n",
    "    ax.set_title(name)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ],
   "execution_count": null,
   "outputs": []
  },
